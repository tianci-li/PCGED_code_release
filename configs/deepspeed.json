{
  "train_batch_size": 64,
  "train_micro_batch_size_per_gpu": 4,
  "gradient_accumulation_steps": 2,
  "steps_per_print": 50,
  "wall_clock_breakdown": false,
  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 2.0e-5,
      "betas": [0.9, 0.95],
      "eps": 1e-8,
      "weight_decay": 0.1
    }
  },
  "scheduler": {
    "type": "WarmupDecayLR",
    "params": {
      "warmup_min_lr": [1.0e-6, 2.0e-7],
      "warmup_max_lr": [2.0e-5, 5.0e-6],
      "warmup_num_steps": 1500,
      "total_num_steps": 200000
    }
  },
  "zero_optimization": {
    "stage": 2,
    "allgather_partitions": true,
    "allgather_bucket_size": 5e8,
    "overlap_comm": true,
    "reduce_scatter": true,
    "reduce_bucket_size": 5e8,
    "contiguous_gradients": true
  },
  "fp16": {"enabled": false},
  "bf16": {"enabled": true},
  "gradient_clipping": 1.0,
  "pipeline": {
    "pipe_partitioned": false,
    "grad_partitioned": false
  },
  "zero_force_ds_cpu_optimizer": false,
  "comms_logger": {"enabled": false}
}
